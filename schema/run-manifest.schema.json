{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "type": "object",
  "required": [
    "run_id",
    "date",
    "hypotheses",
    "matrix",
    "mms",
    "research_program",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "executed",
        "evaluated",
        "archived"
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matrix": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      }
    },
    "mms": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      }
    },
    "research_program": {
      "type": "object",
      "required": [
        "anchor"
      ],
      "properties": {
        "anchor": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "tooling": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    }
  }
}